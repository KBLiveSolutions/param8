---
import type { Props } from '@astrojs/starlight/props';
import discordIcon from '../assets/Discord-Symbol-Black.svg';
import githubIcon from '../assets/github-icon.png';
import instagramIcon from '../assets/Instagram_Icon.webp';
---

<footer class="site-footer">
  <div class="footer-content">
    <section class="footer-newsletter" aria-labelledby="newsletter-title">
      <h2 id="newsletter-title">Stay informed</h2>
      <p>Get occasional updates about param8.</p>
      <form class="newsletter-form" action="https://formspree.io/f/xaenweaa" method="POST">
        <input type="hidden" name="_subject" value="New param8 newsletter signup" />
        <input type="hidden" name="form-type" value="newsletter" />
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="honeypot" aria-hidden="true" />
        <label for="newsletter-email-footer" class="sr-only">Email address</label>
        <input
          id="newsletter-email-footer"
          name="email"
          type="email"
          placeholder="Your email address"
          autocomplete="email"
          required
        />
        <button type="submit">Subscribe</button>
        <p class="newsletter-status" role="status" aria-live="polite"></p>
      </form>
    </section>

    <nav class="footer-social" aria-label="Social links">
      <a href="https://discord.gg/rX5sDXGU89" aria-label="Join the param8 Discord" target="_blank" rel="noopener noreferrer">
        <img src={discordIcon.src} alt="" aria-hidden="true" />
        <span>Discord</span>
      </a>
      <a href="https://www.instagram.com/kblivesolutions" aria-label="Connect on Instagram" target="_blank" rel="noopener noreferrer">
        <img src={instagramIcon.src} alt="" aria-hidden="true" />
        <span>Instagram</span>
      </a>
      <a href="https://github.com/KBLiveSolutions/param8-firmware" aria-label="Access the param8 GitHub repository" target="_blank" rel="noopener noreferrer">
        <img src={githubIcon.src} alt="" aria-hidden="true" />
        <span>GitHub</span>
      </a>
    </nav>

    <p class="footer-copyright">© 2026 <a href="https://www.kblivesolutions.com" target="_blank" rel="noopener noreferrer">KB Live Solutions</a></p>
  </div>
</footer>

<script>
  const initializeNewsletterForms = () => {
    document.querySelectorAll<HTMLFormElement>('.newsletter-form').forEach((form) => {
      if (form.dataset.initialized) return;
      form.dataset.initialized = 'true';

      const status = form.querySelector<HTMLParagraphElement>('.newsletter-status');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!status || !button) return;

        button.disabled = true;
        status.textContent = 'Sending…';
        status.classList.remove('is-error');

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: new FormData(form),
          });

          if (response.ok) {
            status.textContent = "Thanks! You're on the list.";
            form.reset();
          } else {
            status.textContent = 'Something went wrong. Please try again.';
            status.classList.add('is-error');
          }
        } catch {
          status.textContent = 'Network error. Please try again.';
          status.classList.add('is-error');
        } finally {
          button.disabled = false;
        }
      });
    });
  };

  initializeNewsletterForms();
  document.addEventListener('astro:page-load', initializeNewsletterForms);
</script>

<style>
  .site-footer {
    padding: 2.5rem 1.5rem 1.5rem;
    border-top: 1px solid var(--sl-color-hairline, #353841);
    color: var(--sl-color-text, #eceef2);
    background: var(--sl-color-bg-nav, #24272f);
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  .footer-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.5rem 3rem;
    max-width: 72rem;
    margin: 0 auto;
  }
  .footer-newsletter h2 {
    margin: 0;
    color: var(--sl-color-text, #eceef2);
    font-size: 1rem;
  }
  .footer-newsletter > p {
    margin: 0.25rem 0 0.75rem;
    font-size: 0.9rem;
  }
  .newsletter-form {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    position: relative;
  }
  .newsletter-form input[type="email"] {
    width: min(18rem, 100%);
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--sl-color-hairline, #353841);
    border-radius: 5px;
    background: var(--sl-color-bg, #17181c);
    color: var(--sl-color-text, #eceef2);
    font: inherit;
    font-size: 1rem;
  }
  .newsletter-form input[type="email"]:focus {
    outline: 2px solid var(--sl-color-text-accent, #4a9eff);
    outline-offset: 1px;
  }
  .newsletter-form button {
    padding: 0.65rem 0.9rem;
    border: 0;
    border-radius: 5px;
    background: var(--sl-color-accent-high, #0258c1);
    color: var(--sl-color-white, #fff);
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    white-space: nowrap;
  }
  .newsletter-form button:hover { opacity: 0.85; }
  .newsletter-form button:disabled { opacity: 0.6; cursor: default; }
  .newsletter-status {
    width: 100%;
    margin: 0.25rem 0 0;
    color: var(--sl-color-text, #eceef2);
    font-size: 0.85rem;
  }
  .newsletter-status:empty { display: none; }
  .newsletter-status.is-error { color: var(--sl-color-red-high, #ff8a8a); }
  .honeypot { position: absolute; left: -9999px; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
  .footer-social {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 1rem;
  }
  .footer-social a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--sl-color-text, #eceef2);
    font-size: 0.9rem;
    text-decoration: none;
  }
  .footer-social img {
    width: 1.25rem;
    height: 1.25rem;
    object-fit: contain;
  }
  .footer-social img { filter: invert(1); }
  :global(:root[data-theme='light']) .footer-social img { filter: none; }
  .footer-social a:hover { color: var(--sl-color-text-accent, #4a9eff); }
  .footer-copyright {
    grid-column: 1 / -1;
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-hairline, #353841);
    font-size: 0.85rem;
  }
  .footer-copyright a {
    color: var(--sl-color-text, #eceef2);
    text-decoration: none;
  }
  .footer-copyright a:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .footer-content { grid-template-columns: 1fr; }
    .footer-social { justify-content: flex-start; }
    .footer-copyright { grid-column: 1; }
    .newsletter-form input[type="email"] { flex: 1 1 12rem; }
  }
</style>
