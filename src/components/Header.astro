---
import { ClientRouter } from 'astro:transitions';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { text: 'Get Started', href: `${base}/docs/overview/` },
  { text: 'Online Editor', href: `${base}/editor/` },
  { text: 'About/Contact', href: `${base}/contact/` },
];
---

<ClientRouter />

<header class="topbar" transition:persist>
  <div class="topbar-inner">
    <a href={`${base}/`} class="topbar-logo">
      <img src={`${base}/logo.svg`} alt="param8" height="28" />
    </a>
    <nav class="topbar-nav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} class="topbar-link">{l.text}</a>
      ))}
      <a href={`${base}/order/`} class="topbar-order">Order</a>
    </nav>
    <button class="topbar-menu-btn" aria-label="Menu" aria-expanded="false">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
        <rect y="3" width="20" height="2" rx="1" />
        <rect y="9" width="20" height="2" rx="1" />
        <rect y="15" width="20" height="2" rx="1" />
      </svg>
    </button>
  </div>
  <nav class="topbar-mobile-nav" aria-label="Mobile">
    {links.map((l) => (
      <a href={l.href} class="topbar-mobile-link">{l.text}</a>
    ))}
    <a href={`${base}/order/`} class="topbar-mobile-order">Order param8</a>
  </nav>
</header>

<aside class="cookie-banner" aria-label="Cookie consent" transition:persist>
  <p>We use Google Analytics to understand how visitors use this site.</p>
  <div class="cookie-actions">
    <button class="cookie-reject" type="button">Reject</button>
    <button class="cookie-accept" type="button">Accept analytics</button>
  </div>
</aside>

<script is:inline>
  const analyticsId = 'G-CHV091CXE4';
  const consentKey = 'param8-analytics-consent';

  window.dataLayer = window.dataLayer || [];
  window.gtag = function gtag() { window.dataLayer.push(arguments); };
  window.gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied',
    wait_for_update: 500
  });

  const loadAnalytics = () => {
    if (document.querySelector('script[data-param8-analytics]')) return;

    window.gtag('consent', 'update', {
      ad_storage: 'granted',
      ad_user_data: 'granted',
      ad_personalization: 'granted',
      analytics_storage: 'granted'
    });
    window.gtag('js', new Date());
    window.gtag('config', analyticsId);

    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${analyticsId}`;
    script.dataset.param8Analytics = 'true';
    document.head.appendChild(script);
  };

  const banner = document.querySelector('.cookie-banner');
  const consent = localStorage.getItem(consentKey);

  if (consent === 'accepted') loadAnalytics();
  if (consent) banner?.setAttribute('hidden', '');

  document.querySelector('.cookie-accept')?.addEventListener('click', () => {
    localStorage.setItem(consentKey, 'accepted');
    banner?.setAttribute('hidden', '');
    loadAnalytics();
  });

  document.querySelector('.cookie-reject')?.addEventListener('click', () => {
    localStorage.setItem(consentKey, 'rejected');
    banner?.setAttribute('hidden', '');
  });
</script>

<script>
  const btn = document.querySelector('.topbar-menu-btn');
  const nav = document.querySelector('.topbar-mobile-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
  });

</script>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #f0f0f0;
    color: #333;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    border-bottom: 1px solid #ddd;
    padding: 0 1rem;
    margin: 0;
    width: 100%;
    box-sizing: border-box;
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    height: 3.5rem;
    max-width: 72rem;
    margin: 0 auto;
    gap: 1.5rem;
  }
  .topbar-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .topbar-logo img { height: 28px; }
  .topbar-nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    margin-left: auto;
    flex-shrink: 0;
  }
  .topbar-link {
    color: #333;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .topbar-link:hover { color: #111; }
  .topbar-order,
  .topbar-mobile-order {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
    background: #111;
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .topbar-order { padding: 0.55rem 0.9rem; }
  .topbar-order:hover,
  .topbar-mobile-order:hover { opacity: 0.85; }
  .topbar-menu-btn {
    display: none;
    background: none;
    border: none;
    color: #333;
    cursor: pointer;
    margin-left: auto;
    padding: 0.25rem;
  }
  .topbar-mobile-nav {
    display: none;
    flex-direction: column;
    padding: 0.5rem 0 1rem;
    max-width: 72rem;
    margin: 0 auto;
  }
  .topbar-mobile-nav.open { display: flex; }
  .topbar-mobile-link {
    color: #333;
    text-decoration: none;
    padding: 0.5rem 0;
    font-size: 0.95rem;
    font-weight: 500;
  }
  .topbar-mobile-link:hover { color: #111; }
  .topbar-mobile-order {
    align-self: flex-start;
    margin-top: 0.5rem;
    padding: 0.65rem 1rem;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
  .cookie-banner[hidden] { display: none; }
  .cookie-banner {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 200;
    display: flex;
    align-items: center;
    gap: 1rem;
    width: min(34rem, calc(100% - 2rem));
    padding: 1rem 1.25rem;
    box-sizing: border-box;
    color: var(--sl-color-text, #eceef2);
    background: var(--sl-color-bg-nav, #24272f);
    border: 1px solid var(--sl-color-hairline, #353841);
    border-radius: 8px;
    box-shadow: 0 8px 24px rgb(0 0 0 / 15%);
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 0.85rem;
  }
  .cookie-banner p { margin: 0; line-height: 1.4; }
  .cookie-actions { display: flex; gap: 0.5rem; flex-shrink: 0; }
  .cookie-actions button {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--sl-color-hairline, #353841);
    border-radius: 4px;
    background: var(--sl-color-bg, #17181c);
    color: var(--sl-color-text, #eceef2);
    cursor: pointer;
    font: inherit;
    white-space: nowrap;
  }
  .cookie-actions .cookie-accept {
    border-color: var(--sl-color-accent-high, #0258c1);
    background: var(--sl-color-accent-high, #0258c1);
    color: var(--sl-color-white, #fff);
  }
  .cookie-actions button:hover { opacity: 0.8; }
  @media (max-width: 640px) {
    .topbar-nav { display: none; }
    .topbar-menu-btn { display: block; }
    .cookie-banner { display: block; }
    .cookie-actions { margin-top: 0.75rem; }
  }
</style>
