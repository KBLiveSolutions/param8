---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { text: 'Get Started', href: `${base}/docs/overview/` },
  { text: 'Online Editor', href: `${base}/editor/` },
  { text: 'Order', href: `${base}/order/` },
];
---

<header class="topbar">
  <div class="topbar-inner">
    <a href={`${base}/`} class="topbar-logo">
      <img src={`${base}/logo.svg`} alt="param8" height="28" />
    </a>
    <span class="topbar-tagline">Compact USB MIDI controller designed for Ableton Live.</span>
    <nav class="topbar-nav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} class="topbar-link">{l.text}</a>
      ))}
      <a
        href="https://discord.gg/rX5sDXGU89"
        class="discord-link"
        aria-label="Join the param8 Discord"
        target="_blank"
        rel="noopener noreferrer"
        title="Join the param8 Discord"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M19.54 0H4.46A4.46 4.46 0 0 0 0 4.46v15.08A4.46 4.46 0 0 0 4.46 24h15.08A4.46 4.46 0 0 0 24 19.54V4.46A4.46 4.46 0 0 0 19.54 0Zm-3.08 17.15s-.55-.66-1-1.25c1.98-.56 2.73-1.8 2.73-1.8-.62.41-1.22.7-1.76.9-.77.32-1.51.53-2.24.66-1.48.27-2.83.2-3.98-.01-.88-.17-1.64-.39-2.27-.66-.35-.13-.73-.29-1.11-.5-.04-.02-.08-.04-.12-.06-.02-.01-.03-.02-.05-.03-.27-.15-.42-.24-.42-.24s.72 1.21 2.64 1.79c-.45.59-1.01 1.29-1.01 1.29-3.33-.1-4.6-2.29-4.6-2.29 0-4.86 2.17-8.8 2.17-8.8 2.17-1.62 4.23-1.58 4.23-1.58l.15.18c-2.71.78-3.96 1.96-3.96 1.96s.33-.18.88-.43c1.6-.7 2.87-.89 3.39-.94.08-.01.15-.02.23-.02 0 0 .03 0 .06.01.91-.12 1.94-.15 3.02-.03 1.13.13 2.34.46 3.57 1.02 0 0-1.19-1.13-3.76-1.91l.21-.24s2.06-.04 4.23 1.58c0 0 2.17 3.94 2.17 8.8 0 0-1.29 2.19-4.62 2.29ZM8.82 11.37c-.87 0-1.58.8-1.58 1.79s.71 1.79 1.58 1.79 1.58-.8 1.58-1.79-.71-1.79-1.58-1.79Zm6.36 0c-.87 0-1.58.8-1.58 1.79s.71 1.79 1.58 1.79 1.58-.8 1.58-1.79-.71-1.79-1.58-1.79Z" />
        </svg>
      </a>
    </nav>
    <button class="topbar-menu-btn" aria-label="Menu" aria-expanded="false">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
        <rect y="3" width="20" height="2" rx="1" />
        <rect y="9" width="20" height="2" rx="1" />
        <rect y="15" width="20" height="2" rx="1" />
      </svg>
    </button>
  </div>
  <nav class="topbar-mobile-nav" aria-label="Mobile">
    {links.map((l) => (
      <a href={l.href} class="topbar-mobile-link">{l.text}</a>
    ))}
    <a href="https://discord.gg/rX5sDXGU89" class="topbar-mobile-link" target="_blank" rel="noopener noreferrer">Discord</a>
  </nav>
</header>

<script>
  const btn = document.querySelector('.topbar-menu-btn');
  const nav = document.querySelector('.topbar-mobile-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #f0f0f0;
    border-bottom: none;
    padding: 0 1rem;
    margin: 0;
    width: 100%;
    box-sizing: border-box;
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    height: 3.5rem;
    max-width: 72rem;
    margin: 0 auto;
    gap: 1.5rem;
  }
  .topbar-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .topbar-logo img { height: 28px; }
  .topbar-tagline {
    color: #666;
    font-size: 0.8rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .topbar-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-left: auto;
    flex-shrink: 0;
  }
  .topbar-link {
    color: #333;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .topbar-link:hover, .discord-link:hover { color: var(--sl-color-text-accent); }
  .discord-link {
    display: flex;
    align-items: center;
    color: #333;
    width: 20px;
    height: 20px;
    text-decoration: none;
  }
  .discord-link svg { width: 20px; height: 20px; }
  .topbar-menu-btn {
    display: none;
    background: none;
    border: none;
    color: #333;
    cursor: pointer;
    margin-left: auto;
    padding: 0.25rem;
  }
  .topbar-mobile-nav {
    display: none;
    flex-direction: column;
    padding: 0.5rem 0 1rem;
    max-width: 72rem;
    margin: 0 auto;
  }
  .topbar-mobile-nav.open { display: flex; }
  .topbar-mobile-link {
    color: #333;
    text-decoration: none;
    padding: 0.5rem 0;
    font-size: 0.95rem;
    font-weight: 500;
  }
  .topbar-mobile-link:hover { color: var(--sl-color-text-accent); }
  @media (max-width: 640px) {
    .topbar-nav { display: none; }
    .topbar-tagline { display: none; }
    .topbar-menu-btn { display: block; }
  }
</style>
