---
import Header from '../components/Header.astro';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>param8 Online Editor</title>
  </head>
  <body>
    <Header />
    <main class="fullscreen-app">
      <iframe src="https://kblivesolutions.github.io/param8-editor/" title="param8 Online Editor" allow="serial"></iframe>
    </main>
  </body>
</html>

<style>
  :global(html), :global(body) {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
  }

  .fullscreen-app {
    width: 100%;
    height: calc(100vh - 3.5rem);
    margin: 0;
    padding: 0;
  }

  iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 700px;
    border: 0;
  }
</style>
