---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>param8 Editor</title>
  </head>
  <body>
    <Header />
    <main class="editor-page">
      <iframe
        src="https://kblivesolutions.github.io/param8-editor/"
        title="param8 Online Editor"
        class="app-frame"
        allow="serial"
      ></iframe>
    </main>
    <Footer />
  </body>
</html>

<style>
  :global(html),
  :global(body) {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
  }

  :global(body) {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #fff;
  }

  .editor-page {
    width: 100%;
    height: calc(100vh - 3.5rem);
    min-height: 760px;
    margin: 0;
    padding: 0;
  }

  .app-frame {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 760px;
    border: 0;
    margin: 0;
    padding: 0;
    background: #1a1a2e;
  }

  :global(.site-footer) {
    display: none;
  }
</style>
