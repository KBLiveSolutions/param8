---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>param8 | Contact</title>
    <meta name="description" content="Contact the param8 team." />
  </head>
  <body>
    <Header />

    <main class="contact-page">
      <section class="contact-card" aria-labelledby="contact-title">
        <p class="contact-eyebrow">Get in touch</p>
        <h1 id="contact-title">Contact param8</h1>
        <p class="contact-intro">
          Have a question about the controller, your order, or the editor? Send us a message and we will get back to you.
        </p>

        <form action="https://formspree.io/f/xaenweaa" method="POST">
          <input type="hidden" name="_subject" value="New param8 contact message" />
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="honeypot" aria-hidden="true" />

          <div class="form-field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" autocomplete="name" required />
          </div>

          <div class="form-field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>

          <div class="form-field">
            <label for="topic">Topic</label>
            <select id="topic" name="topic">
              <option value="Support">Support</option>
              <option value="Order">Order</option>
              <option value="Partnership">Partnership</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div class="form-field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="7" required></textarea>
          </div>

          <button type="submit">Send message</button>
        </form>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(html),
  :global(body) {
    margin: 0;
    min-height: 100%;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #fff;
    color: #111;
  }

  .contact-page {
    min-height: calc(100vh - 3.5rem);
    display: grid;
    place-items: center;
    padding: 3rem 1.5rem;
    box-sizing: border-box;
  }

  .contact-card {
    width: min(620px, 100%);
    padding: 2.5rem;
    border: 1px solid #ddd;
    border-radius: 12px;
    background: #fff;
    box-sizing: border-box;
  }

  .contact-eyebrow {
    margin: 0 0 0.5rem;
    color: #666;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: 2.2rem;
  }

  .contact-intro {
    max-width: 48ch;
    margin: 0.75rem 0 2rem;
    color: #666;
    line-height: 1.5;
  }

  form {
    display: grid;
    gap: 1.1rem;
  }

  .form-field {
    display: grid;
    gap: 0.4rem;
  }

  label {
    font-size: 0.9rem;
    font-weight: 600;
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #bbb;
    border-radius: 5px;
    box-sizing: border-box;
    color: #111;
    background: #fff;
    font: inherit;
  }

  textarea { resize: vertical; }
  input:focus, select:focus, textarea:focus { outline: 2px solid #4a9eff; outline-offset: 1px; }

  button {
    justify-self: start;
    padding: 0.8rem 1.25rem;
    border: 0;
    border-radius: 5px;
    background: #111;
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
  }

  button:hover { opacity: 0.85; }
  .honeypot { position: absolute; left: -9999px; }

  @media (max-width: 640px) {
    .contact-page { padding: 2rem 1rem; }
    .contact-card { padding: 1.5rem; }
    h1 { font-size: 1.8rem; }
  }
</style>
