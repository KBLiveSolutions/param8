---
import Header from '../components/Header.astro';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Order param8</title>
  </head>
  <body>
    <Header />
    <main class="fullscreen-app">
      <iframe
        src="https://buy.stripe.com/bJe5kC2DBgwVfywaR9bjW00"
        title="Order param8"
        allow="payment"
      ></iframe>
    </main>
  </body>
</html>

<style>
  :global(html), :global(body) {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
  }

  .fullscreen-app {
    width: 100%;
    height: calc(100vh - 3.5rem);
    margin: 0;
    padding: 0;
  }

  iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 700px;
    border: 0;
  }
</style>
